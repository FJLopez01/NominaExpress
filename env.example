# ============================================================
# Sistema de Envio de Nóminas  — Plantilla de configuración
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo:  cp .env.example .env
#   2. Rellena cada valor con los datos reales
#   3. NUNCA subas .env al repositorio
# ============================================================


# ── Rutas del sistema ──────────────────────────────────────────────
# Carpeta raíz donde están XML/, PDFs/ y correos_colaboradores.xlsx
# Windows:  BASE_PATH=C:\Nominas
# macOS:    BASE_PATH=/Users/tu-usuario/Nominas
BASE_PATH=


# ── Microsoft 365 — Graph API ──────────────────────────────────────
# Guía de configuración paso a paso en: docs/configurar_azure_ad.md
#
# AZURE_TENANT_ID:     "Identificador de directorio (inquilino)" en Azure AD
# AZURE_CLIENT_ID:     "Id. de aplicación (cliente)" en Azure AD
# AZURE_CLIENT_SECRET: Valor del secreto creado en "Certificados y secretos"
# EMAIL_SENDER:        Cuenta de M365 desde la que salen los correos

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
EMAIL_SENDER=nominas@tuempresa.com
